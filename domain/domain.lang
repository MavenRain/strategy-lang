-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family that is not an enumeration (rule R1).
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
-- An indexed family (former F15): `Lot 3` is a lot of size 3.
family Lot (size : Nat) := makeLot (lotPrice : Nat)

def lineTotal : (item : Item) -> Nat :=
  fun (item : Item) => natMul (itemPrice item) (itemCount item)
def isRed : (color : Color) -> Flag :=
  fun (color : Color) => fold flagYes flagNo flagNo color
def total : (items : List Item) -> Nat :=
  fun (items : List Item) => fold (fun (item : Item) (acc : Nat) => natAdd (lineTotal item) acc) 0 items
def redTotal : (items : List Item) -> Nat :=
  fun (items : List Item) => total (filter (fun (item : Item) => isRed (itemColor item)) items)
def depth : (s : Stack) -> Nat :=
  fun (s : Stack) => fold 0 (fun (top : Nat) (rest : Nat) => natAdd rest 1) s

-- Higher inductive types (S2). A path constructor `: Eq F a b` adds a path
-- between two point terms of F. A fold gives one case per constructor.
family Circle := base | loop : Eq Circle base base
family Interval := zero | one | seg : Eq Interval zero one
family Quot (A : Type 0) (R : A -> A -> Type 0) :=
    class (elem : A)
  | glue (from : A) (to : A) (rel : R from to) : Eq (Quot A R) (class A R from) (class A R to)

-- The CGS core (S4a, S4b). `snoc S xs x` puts `x` at the end of `xs`. `Pth S`
-- is a lasso: a stem, then a cycle that is not empty (`lhead`, then `ltail`).
-- The paths (S4b) move the head of the cycle to the end of the stem: `unroll`
-- for a cycle of 2 or more states, `unrollOne` for a cycle of 1 state. A
-- strategy is a Mealy machine: a memory `M`, an output and an update on each
-- state.
def snoc : (S : Type 0) -> List S -> S -> List S :=
  fun (S : Type 0) (xs : List S) (x : S) => fold (fun (y : S) (acc : List S) => cons y acc) (cons x nil) xs
family Pth (S : Type 0) :=
    lasso (lstem : List S) (lhead : S) (ltail : List S)
  | unroll (upre : List S) (uc : S) (ud : S) (uds : List S) : Eq (Pth S) (lasso S upre uc (cons ud uds)) (lasso S (snoc S upre uc) ud (snoc S uds uc))
  | unrollOne (opre : List S) (oc : S) : Eq (Pth S) (lasso S opre oc nil) (lasso S (snoc S opre oc) oc nil)
family Mealy (M : Type 0) (S : Type 0) (A : Type 0) :=
    machine (mInit : M) (mOut : M -> S -> A) (mUpd : M -> S -> M)
-- `mealyRun g xs h m`: the action at the last state of `h :: xs`, after the
-- memory `m` reads each state before it, in order.
def mealyRun : (M : Type 0) -> (S : Type 0) -> (A : Type 0) -> Mealy M S A -> List S -> S -> M -> A :=
  fun (M : Type 0) (S : Type 0) (A : Type 0) (g : Mealy M S A) (xs : List S) =>
    fold (fun (x : S) (k : S -> M -> A) => fun (h : S) (m : M) => k x (mUpd g m h)) (fun (h : S) (m : M) => mOut g m h) xs
def mealyAct : (M : Type 0) -> (S : Type 0) -> (A : Type 0) -> Mealy M S A -> Prod S (List S) -> Option A :=
  fun (M : Type 0) (S : Type 0) (A : Type 0) (g : Mealy M S A) (t : Prod S (List S)) =>
    some (mealyRun M S A g (second t) (first t) (mInit g))
-- Play (R7 (a)): `visitsOf W f c fuel w0` lists the states from `w0` under
-- `f` up to the first state whose code `c` is seen again. A short fuel
-- gives a list with no repeat.
def noCodes : List Nat := nil
def seenCode : Nat -> List Nat -> Flag :=
  fun (n : Nat) (ns : List Nat) => fold (fun (d : Nat) (acc : Flag) => flagIf (natEq n d) flagYes acc) flagNo ns
def stopVisit : (W : Type 0) -> Option (Prod W (Prod W (List Nat))) := fun (W : Type 0) => none
def visitsOf : (W : Type 0) -> (W -> W) -> (W -> Nat) -> Nat -> W -> List W :=
  fun (W : Type 0) (f : W -> W) (c : W -> Nat) (fuel : Nat) (w0 : W) =>
    unfold (fun (p : Prod W (List Nat)) => flagIf (seenCode (c (first p)) (second p)) (stopVisit W) (some (pair (first p) (pair (f (first p)) (cons (c (first p)) (second p)))))) fuel (pair w0 noCodes)
-- `lassoParts W c ws r` splits `ws` at the first entry with the code of the
-- repeat state `r`: the entries before it (the stem), that entry (the head)
-- and the entries after it (the tail). `lassoOf` builds the lasso from them.
def lassoSeed : (W : Type 0) -> Prod (Option (Prod (List W) (Prod W (List W)))) (List W) := fun (W : Type 0) => pair none nil
def lassoParts : (W : Type 0) -> (W -> Nat) -> List W -> W -> Option (Prod (List W) (Prod W (List W))) :=
  fun (W : Type 0) (c : W -> Nat) (ws : List W) (r : W) =>
    first (fold (fun (x : W) (acc : Prod (Option (Prod (List W) (Prod W (List W)))) (List W)) =>
        pair (flagIf (natEq (c x) (c r)) (some (pair nil (pair x (second acc)))) (map (fun (t : Prod (List W) (Prod W (List W))) => pair (cons x (first t)) (second t)) (first acc)))
          (cons x (second acc)))
      (lassoSeed W) ws)
def lassoOf : (W : Type 0) -> (W -> Nat) -> List W -> W -> Option (Pth W) :=
  fun (W : Type 0) (c : W -> Nat) (ws : List W) (r : W) =>
    map (fun (t : Prod (List W) (Prod W (List W))) => lasso W (first t) (first (second t)) (second (second t))) (lassoParts W c ws r)
