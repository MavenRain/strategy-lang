-- The next state is false. One visit does not close the two-state play.
def flip : Flag -> Flag := fun (s : Flag) => flagIf s flagNo flagYes
def codeF : Flag -> Nat := fun (s : Flag) => flagIf s 0 1
def labF : Flag -> Nat -> Flag := fun (s : Flag) (a : Nat) => s
def falseNext : SatPlay Flag flip codeF 1 labF flagYes (lnext (atom 0)) 0 := refl
